<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.serviceprovider.mapper.UserInfoMapper">

    <select id="queryList" resultType="org.example.serviceprovider.entity.po.UserEntity">
        select * from user where id =#{id}
    </select>

    <insert id="insertUser">
        insert into user(id, name, password, age, email) values(#{id},#{name},#{password},#{age},#{email})
    </insert>

    <insert id="batchSaveUser">
        insert into user (id, name, password, age, email) values
        <foreach collection="users" item="u" separator=",">
            (#{u.id}, #{u.name}, #{u.password}, #{u.age}, #{u.email})
        </foreach>
    </insert>

</mapper>